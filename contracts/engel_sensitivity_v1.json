  "price_mapping": {
    "total_expenditure": "each frozen Phase-A COICOP division share uses its same-id regional IPC division",
    "food": {
      "coicop01": "priced with coicop01",
      "alcoholic_beverages_021": "food under frozen Artifact-A rule; priced with coicop02",
