  },
  "identities": {
    "ICE_official": "CBT_official / CBA_official",
    "food_cost_t": "share_coicop01 * relative_price_coicop01 + share_alcohol021 * relative_price_coicop02",
    "total_cost_t": "sum_d share_d * relative_price_d",
    "food_share_t": "food_cost_t / total_cost_t",
    "ICE_engho17_t": "total_cost_t / food_cost_t",
    "level_factor_r": "ICE_engho17_r,b / ICE_official_r,b",
    "trajectory_factor_r,t": "(ICE_engho17_r,t / ICE_engho17_r,b) / (ICE_official_r,t / ICE_official_r,b)",
    "full_factor_r,t": "level_factor_r * trajectory_factor_r,t",
    "CBT_engho17_r,t": "CBA_official_r,t * ICE_engho17_r,t",
    "CBT_level_only_r,t": "CBT_official_r,t * level_factor_r",
    "CBT_level_plus_trajectory_r,t": "CBT_official_r,t * full_factor_r"
  },
  "line_path_ids": [
